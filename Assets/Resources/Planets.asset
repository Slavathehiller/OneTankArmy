  Data:
  - ID: -1
    Image: {fileID: 21300000, guid: 59a34443a32fc3b4d80eef1b2cbd3722, type: 3}
    Name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E"
    Description: "\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430"
    OutpostScene: 
  - ID: 1
    Image: {fileID: 21300000, guid: 93380ec52aefbe44cb562679ce27c2aa, type: 3}
    Name: "\u0410\u0440\u0430\u0445\u043D\u0438\u044F"
    Description: "\u041A\u043B\u0438\u043C\u0430\u0442 \u0410\u0440\u0430\u0445\u043D\u0438\u0438
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u043E\u0442\u043B\u0438\u0447\u0438\u043C
      \u043E\u0442 \u0437\u0435\u043C\u043D\u043E\u0433\u043E \u2014 \u0437\u0430
      \u043E\u0434\u043D\u0438\u043C \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C:
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0437\u0434\u0435\u0441\u044C
      \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u043F\u0435\u0440\u0435\u043D\u0430\u0441\u044B\u0449\u0435\u043D\u0430
      \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u043E\u043C. \u0412 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438
      \u0441 \u043D\u0438\u0437\u043A\u043E\u0439 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0435\u0439
      \u044D\u0442\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u043E
      \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0432 \u0446\u0430\u0440\u0441\u0442\u0432\u043E
      \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445. \u041E\u043D\u0438
      \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0438 \u0437\u0434\u0435\u0441\u044C
      \u043F\u043E\u0438\u0441\u0442\u0438\u043D\u0435 \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0445
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432 \u0438 \u0437\u0430\u043D\u044F\u043B\u0438
      \u043A\u0430\u0436\u0434\u0443\u044E \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043D\u0438\u0448\u0443. \u0423 \u0434\u0438\u043D\u043E\u0437\u0430\u0432\u0440\u043E\u0432
      \u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0433\u043E
      \u0448\u0430\u043D\u0441\u0430."
    OutpostScene: ArachniaOutpostScene
  - ID: 2
    Image: {fileID: 21300000, guid: 27126673b4277b545a7190c79424e77b, type: 3}
    Name: "\u041D\u043E\u043A\u0442\u044E\u0440\u043D"
    Description: "\u041D\u043E\u043A\u0442\u044E\u0440\u043D \u2014 \u043A\u043E\u043B\u044B\u0431\u0435\u043B\u044C
      \u0432\u044B\u0441\u043E\u043A\u043E\u0440\u0430\u0437\u0432\u0438\u0442\u043E\u0439
      \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438. \u041A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0435\u0451 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043B
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u0435\u0439,
      \u0438 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u044B \u0431\u043E\u0435\u0432\u044B\u0445
      \u043C\u0430\u0448\u0438\u043D \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043B\u044E\u0434\u0435\u0439. \u041E\u0441\u043E\u0437\u043D\u0430\u0432,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u044E\u0442,
      \u043B\u044E\u0434\u0438 \u043F\u043E\u0448\u043B\u0438 \u043D\u0430 \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0439
      \u0448\u0430\u0433 \u2014 \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438
      \u0440\u0443\u043A\u043E\u0442\u0432\u043E\u0440\u043D\u0443\u044E \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0443. \u041A\u0430\u043A\u0443\u044E
      \u0438\u043C\u0435\u043D\u043D\u043E, \u043A\u0441\u0435\u043D\u043E\u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u0438:
      \u043F\u0440\u043E\u0448\u043B\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438.
      \u041D\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D:
      \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u044B \u0442\u043E\u043D\u043D
      \u043F\u044B\u043B\u0438 \u0438 \u043F\u0435\u043F\u043B\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0438\u0441\u044C
      \u0432 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443 \u0438 \u0437\u0430\u043A\u0440\u044B\u043B\u0438
      \u043C\u0435\u0441\u0442\u043D\u043E\u0435 \u0441\u043E\u043B\u043D\u0446\u0435.
      \u0414\u043B\u044F \u041D\u043E\u043A\u0442\u044E\u0440\u043D\u0430 \u044D\u0442\u043E
      \u0441\u0442\u0430\u043B\u043E \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440\u043E\u043C.
      \u041F\u043B\u0430\u043D\u0435\u0442\u0430 \u0431\u0435\u0434\u043D\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C\u0438
      \u0438\u0441\u043A\u043E\u043F\u0430\u0435\u043C\u044B\u043C\u0438 \u0438 \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438, \u0438 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442 \u0437\u0434\u0435\u0441\u044C \u0431\u044B\u043B
      \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438. \u0423\u0434\u0430\u0440 \u043F\u043E
      \u043C\u0430\u0448\u0438\u043D\u0430\u043C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u043C: \u0441\u0442\u0430\u0440\u044B\u0445
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432 \u0438 \u0442\u0435\u0445 \u043A\u0440\u043E\u0445,
      \u0447\u0442\u043E \u0443\u0434\u0430\u0451\u0442\u0441\u044F \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C,
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u0430\u0436\u0435
      \u043D\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0435\u0449\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
      \u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u0433\u043E\u0434\u043E\u043C
      \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0435\u0445\u043D\u0438\u043A\u0438
      \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u0435\u0442 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.
      \u042D\u0442\u043E\u0442 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0440\u0430\u0441\u0442\u044F\u043D\u0443\u043B\u0441\u044F
      \u043D\u0430 \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u044F.
      \u0421\u0430\u043C\u0430 \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u044F
      \u041D\u043E\u043A\u0442\u044E\u0440\u043D\u0430 \u043F\u043E\u0433\u0438\u0431\u043B\u0430
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u2014 \u043A\u0430\u043A
      \u0438 \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u044F \u0436\u0438\u0432\u043E\u0442\u043D\u0430\u044F
      \u0438 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0436\u0438\u0437\u043D\u044C. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u041D\u043E\u043A\u0442\u044E\u0440\u043D \u2014 \u044D\u0442\u043E \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u0433\u0440\u0438\u0431\u043E\u0432 \u0438 \u0432\u0435\u0447\u043D\u044B\u0445
      \u0441\u0443\u043C\u0435\u0440\u0435\u043A. \u041C\u0438\u0440, \u043D\u0430\u0441\u0435\u043B\u0451\u043D\u043D\u044B\u0439
      \u043B\u0438\u0448\u044C \u043E\u0437\u043B\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u043C\u0438
      \u043C\u0430\u0448\u0438\u043D\u0430\u043C\u0438, \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u043C\u0438
      \u043B\u044E\u0431\u043E\u0433\u043E \u0447\u0443\u0436\u0430\u043A\u0430 \u0432
      \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438."
    OutpostScene: NocturneOutpostScene
